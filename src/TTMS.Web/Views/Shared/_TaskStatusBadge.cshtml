@using TTMS.Web.Models.Enums
@model TaskItemStatus
@{
    var badgeClass = Model switch
    {
        TaskItemStatus.Todo => "status-todo",
        TaskItemStatus.InProgress => "status-inprogress",
        TaskItemStatus.Pending => "status-pending",
        TaskItemStatus.Blocked => "status-blocked",
        TaskItemStatus.Done => "status-done",
        TaskItemStatus.Cancelled => "status-cancelled",
        _ => "status-todo"
    };
}
<span class="jira-status-badge @badgeClass">@Model.ToString().ToUpper()</span>
