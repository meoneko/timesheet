@model TaskFilterViewModel
@using TTMS.Web.Models.Enums
@{
    var hasFilter = Model.HasAnyFilter;
}
<form method="get" class="card card-body bg-light border-0 mb-3 py-2 px-3" role="search" aria-label="Task filters">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small mb-1" for="filter-Text">Search</label>
            <input id="filter-Text" type="search" name="Text" value="@Model.Text" class="form-control form-control-sm" placeholder="title or description..." autocomplete="off" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="filter-CreatedFrom">Created from</label>
            <input id="filter-CreatedFrom" type="date" name="CreatedFrom" value="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1" for="filter-CreatedTo">Created to</label>
            <input id="filter-CreatedTo" type="date" name="CreatedTo" value="@Model.CreatedTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div class="col-md-4 text-end">
            <button type="submit" class="btn btn-primary btn-sm">Apply</button>
            @if (hasFilter)
            {
                <a href="@Url.Action("Index", new { projectId = Model.ProjectId })" class="btn btn-link btn-sm">Clear</a>
            }
        </div>
    </div>
    <div class="row g-3 mt-1">
        <div class="col-md-6">
            <label class="form-label small mb-1">Status</label>
            <div class="d-flex flex-wrap gap-2">
                @foreach (TaskItemStatus s in Enum.GetValues(typeof(TaskItemStatus)))
                {
                    var isChecked = Model.Statuses.Contains(s);
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="status-@s" name="StatusRaw" value="@s" checked="@isChecked" />
                        <label class="form-check-label small" for="status-@s">@s</label>
                    </div>
                }
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label small mb-1">Priority</label>
            <div class="d-flex flex-wrap gap-2">
                @foreach (TaskPriority p in Enum.GetValues(typeof(TaskPriority)))
                {
                    var isChecked = Model.Priorities.Contains(p);
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="prio-@p" name="PriorityRaw" value="@p" checked="@isChecked" />
                        <label class="form-check-label small" for="prio-@p">@p</label>
                    </div>
                }
            </div>
        </div>
    </div>
    <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
</form>
