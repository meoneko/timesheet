@model TaskFilterViewModel
@using TTMS.Web.Models.Enums
@{
    var hasFilter = Model.HasAnyFilter;
}

<form id="task-filter-form" method="get" class="bg-white border rounded p-3 mb-4" role="search" aria-label="Task filters">
    <div class="row g-3 align-items-center">
        <!-- Search field -->
        <div class="col-md-5">
            <div class="jira-search-wrapper">
                <i class="bi bi-search jira-search-icon"></i>
                <input id="filter-Text" type="search" name="Text" value="@Model.Text" class="form-control form-control-sm jira-search-input w-100" placeholder="Search by title or description..." autocomplete="off" />
            </div>
        </div>
        
        <!-- Date ranges -->
        <div class="col-md-2">
            <input id="filter-CreatedFrom" type="date" name="CreatedFrom" value="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" title="Created from date" />
        </div>
        <div class="col-md-2">
            <input id="filter-CreatedTo" type="date" name="CreatedTo" value="@Model.CreatedTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" title="Created to date" />
        </div>
        
        <!-- Action Buttons -->
        <div class="col-md-3 text-end d-flex gap-2 justify-content-end">
            <button type="submit" class="btn btn-primary btn-sm px-3">
                <i class="bi bi-funnel"></i> Apply
            </button>
            @if (hasFilter)
            {
                <a href="@Url.Action("Index", new { projectId = Model.ProjectId })" class="btn btn-outline-secondary btn-sm px-3">
                    Clear
                </a>
            }
        </div>
    </div>

    <!-- Toggle Pills Row -->
    <div class="row g-3 mt-1 pt-2 border-top">
        <!-- Status Filter Pills -->
        <div class="col-md-6">
            <div class="d-flex align-items-center gap-2">
                <span class="small text-muted fw-bold text-uppercase" style="font-size: 0.75rem; min-width: 60px;">Status:</span>
                <div class="filter-pill-group">
                    @foreach (TaskItemStatus s in Enum.GetValues(typeof(TaskItemStatus)))
                    {
                        var isChecked = Model.Statuses.Contains(s);
                        <input class="btn-check" type="checkbox" id="status-@s" name="StatusRaw" value="@s" checked="@isChecked" />
                        <label class="filter-pill status-@s.ToString().ToLower()" for="status-@s">@s.ToString().ToUpper()</label>
                    }
                </div>
            </div>
        </div>

        <!-- Priority Filter Pills -->
        <div class="col-md-6">
            <div class="d-flex align-items-center gap-2">
                <span class="small text-muted fw-bold text-uppercase" style="font-size: 0.75rem; min-width: 60px;">Priority:</span>
                <div class="filter-pill-group">
                    @foreach (TaskPriority p in Enum.GetValues(typeof(TaskPriority)))
                    {
                        var isChecked = Model.Priorities.Contains(p);
                        <input class="btn-check" type="checkbox" id="prio-@p" name="PriorityRaw" value="@p" checked="@isChecked" />
                        <label class="filter-pill prio-@p.ToString().ToLower()" for="prio-@p">@p.ToString().ToUpper()</label>
                    }
                </div>
            </div>
        </div>
    </div>
    
    <input type="hidden" name="ProjectId" value="@Model.ProjectId" />
    @if (!string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["view"]))
    {
        <input type="hidden" name="view" value="@ViewContext.HttpContext.Request.Query["view"]" />
    }
</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var form = document.getElementById("task-filter-form");
        if (form) {
            form.querySelectorAll("input[type='checkbox'], input[type='date']").forEach(function (input) {
                input.addEventListener("change", function () {
                    form.submit();
                });
            });
        }
    });
</script>
